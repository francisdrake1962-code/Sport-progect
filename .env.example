# Never commit a real .env file. Generate high-entropy secrets for production.
NODE_ENV=development
PORT=3001
JWT_SECRET=replace-with-a-random-64-character-secret
ALLOWED_ORIGIN=http://localhost:3001
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Stripe (Thai account — required in production; keys go here without code changes)
STRIPE_SECRET_KEY=sk_test_replace_with_thai_account_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_thai_account_webhook_secret
# Price IDs from the Stripe dashboard; amounts must match admin settings monthly_price/annual_price
STRIPE_MONTHLY_PRICE_ID=price_replace_with_monthly_price_id
STRIPE_ANNUAL_PRICE_ID=price_replace_with_annual_price_id

# Mux video (paid lessons) — signing keys + API tokens from dashboard.mux.com
MUX_SIGNING_KEY_ID=replace_with_mux_signing_key_id
MUX_SIGNING_KEY=replace_with_mux_signing_key_secret
MUX_ACCESS_TOKEN_ID=replace_with_mux_access_token_id
MUX_ACCESS_TOKEN_SECRET=replace_with_mux_access_token_secret
